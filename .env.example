# Production API origin, including the backend API prefix.
VITE_API_BASE_URL=https://api.example.com/api/v1

# Optional direct IPv6 upload origin. The frontend probes this host and falls
# back to VITE_API_BASE_URL when the client cannot reach the server directly.
VITE_UPLOAD_DIRECT_ORIGIN=https://up.example.com

# Vite dev-server proxy target. This is only used by `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080
